                is_parallel=True,
                compute_emd=compute_emd,
            ),
        ),
        "Clustering": timed_call(
            f"Communities {mode.upper()} Clustering",
            logger,
            lambda: spectre_utils.clustering_stats(
                real_graphs,
                generated_graphs,
                bins=100,
                is_parallel=True,
